{
  "name": "datenj-ger",
  "private": true,
  "version": "2.1.1",
  "desktopName": "datenjager.desktop",
  "description": "DatenJäger - gestión documental cifrada (Electron + React + Tailwind)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5273 && electron . --dev\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "dist": "node scripts/empaquetar.mjs",
    "dist:linux": "node scripts/empaquetar.mjs --linux",
    "dist:win": "node scripts/empaquetar.mjs --win",
    "backend:congelar": "node scripts/empaquetar.mjs --solo-backend"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.1",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
